# Copy to .env.local and fill in real values. .env.local stays out of git.

# PostgreSQL connection string, server-side only.
# Local development: the database from compose.yaml (docker compose up -d).
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Forward Email API token (forwardemail.net → My Account → Security), server-side only.
# Used for sign-in e-mails sent from noreply@trading-academy.app.
FORWARD_EMAIL_API_TOKEN=your-api-token

# Login (Better Auth). The site's address – http://localhost:3000 locally, https://trading-academy.app in production.
BETTER_AUTH_URL=http://localhost:3000
# Signs the session cookies – generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-random-secret

# Google sign-in (Google Cloud Console → Clients → Web application). Optional – without them only the
# magic link works. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Shows the sign-in page, the account page and the account link. "false" until login goes public.
NEXT_PUBLIC_LOGIN_ENABLED=false

# Visit statistics (Umami, self-hosted). Both are needed at build time; without them no script is
# loaded (local development). The script and the events go through /stats on our own domain.
# The website id from Umami → Settings → Websites (public, it is in the page HTML).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# The shared Umami server.
UMAMI_HOST=https://stats.srvr.work
